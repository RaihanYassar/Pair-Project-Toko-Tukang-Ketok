<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f5f5f5;
            color: #292929;
        }

        h2 {
            text-align: center;
            margin: 35px 15px;
            font-size: 28px;
        }

        body > a {
            display: block;
            width: fit-content;
            margin: 0 auto 20px;
            padding: 11px 18px;
            background-color: #ff8c32;
            color: white;
            border-radius: 5px;
            font-size: 14px;
            font-weight: bold;
            text-decoration: none;
        }

        body > a:hover {
            background-color: #e87518;
        }

        body > form {
            display: flex;
            gap: 10px;
            max-width: 600px;
            margin: 0 auto;
            padding: 0 15px;
        }

        input[type="text"] {
            flex: 1;
            min-width: 0;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            outline: none;
        }

        input[type="text"]:focus {
            border-color: #ff8c32;
        }

        button {
            padding: 10px 18px;
            border: none;
            border-radius: 5px;
            background-color: #ff8c32;
            color: white;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background-color: #e87518;
        }

        body > br {
            display: none;
        }

        table {
            width: 92%;
            margin: 25px auto 45px;
            border-collapse: collapse;
            background-color: white;
            border: 1px solid #ddd;
        }

        thead {
            background-color: #292929;
            color: white;
        }

        th {
            padding: 14px 12px;
            font-size: 14px;
            text-align: left;
            white-space: nowrap;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #e5e5e5;
            font-size: 14px;
            vertical-align: middle;
        }

        tbody tr:hover {
            background-color: #fff8f1;
        }

        td img {
            display: block;
            width: 85px;
            height: 85px;
            object-fit: cover;
            border: 1px solid #eee;
            border-radius: 5px;
        }

        td a {
            display: inline-block;
            margin: 3px 0;
            color: #d96b0b;
            font-weight: bold;
            text-decoration: none;
        }

        td a:hover {
            color: #a94f00;
            text-decoration: underline;
        }

        td form {
            display: inline;
        }

        td button {
            padding: 7px 12px;
        }

        @media (max-width: 900px) {
            table {
                width: 96%;
                font-size: 13px;
            }

            th,
            td {
                padding: 9px 7px;
            }

            td img {
                width: 65px;
                height: 65px;
            }
        }

        @media (max-width: 650px) {
            table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }

            h2 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partial/navbar') %>

    <% if (message) { %>
        <p style="color: rgb(255, 0, 0); font-weight: bold; background: #f0e8f5; padding: 10px; border: 1px solid #ff0000; text-align: center;">
            <%= message %>
        </p>
    <% } %>
    <br>

    <h2>Katalog Perkakas</h2>

    <% if (sessionUser && sessionUser.role === 'seller') { %>
        <a href="/products/add">Tambah Produk Baru</a>
        <br><br>
    <% } %>

    <form action="/products" method="GET">
        <input type="text" name="search" placeholder="Cari perkakas..." value="<%= search || '' %>">
        <button type="submit">Cari</button>
    </form>
    <br>

    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>No</th>
                <th>Image</th>
                <th>Nama Produk</th>
                <th>Kategori</th>
                <th>Harga</th>
                <th>Stok</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach((el, i) => { %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><img src="<%= el.imageUrl %>" width="100px" height="100px"></td>
                    <td><%= el.name %></td>
                    <td><%= el.Category ? el.Category.name : 'belum ada category' %></td>
                    <td><%= el.changeToRupiah %></td>
                    <td><%= el.stock %></td>
                    <td>
                        <a href="/products/<%= el.id %>">Detail</a> ||

                        <form action="/products/<%= el.id %>/buy" method="POST" style="display:inline;">
                            <button type="submit">Beli</button>
                        </form>

                        <% if (sessionUser && sessionUser.role === 'seller') { %>
                            || <a href="/products/<%= el.id %>/edit">Edit</a>
                            || <a href="/products/<%= el.id %>/delete">Delete</a>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>