<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px 15px;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f5f5f5;
            color: #292929;
        }

        h2 {
            max-width: 600px;
            margin: 15px auto 25px;
            font-size: 27px;
        }

        form {
            max-width: 600px;
            margin: 0 auto 40px;
            padding: 30px;
            background-color: white;
            border: 1px solid #e0e0e0;
            border-top: 5px solid #ff8c32;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        form div {
            margin-bottom: 5px;
        }

        label {
            display: inline-block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: bold;
            color: #333;
        }

        input,
        select,
        textarea {
            display: block;
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            background-color: white;
            color: #292929;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            outline: none;
            transition: 0.2s;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #ff8c32;
            box-shadow: 0 0 0 3px rgba(255, 140, 50, 0.15);
        }

        select {
            cursor: pointer;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        button,
        form a {
            display: inline-block;
            padding: 12px 18px;
            border: none;
            border-radius: 5px;
            font-size: 14px;
            font-weight: bold;
            text-decoration: none;
            cursor: pointer;
            transition: 0.2s;
        }

        button {
            background-color: #ff8c32;
            color: white;
        }

        button:hover {
            background-color: #e87518;
        }

        form a {
            margin-left: 8px;
            background-color: #e5e5e5;
            color: #333;
        }

        form a:hover {
            background-color: #d4d4d4;
        }

        @media (max-width: 480px) {
            body {
                padding: 20px 12px;
            }

            h2 {
                font-size: 23px;
            }

            form {
                padding: 22px;
            }

            button,
            form a {
                padding: 11px 14px;
            }
        }
    </style>
</head>
<body>
  <h2>Edit Produk: <%= product.name %></h2>

  <form action="/products/<%= product.id %>/edit" method="POST">
    <div>
      <label>Nama Produk:</label><br>
      <input type="text" name="name" value="<%= product.name %>" required>
    </div>
    <br>

    <div>
      <label>Kategori:</label><br>
      <select name="CategoryId" required>
        <option value="">-- Pilih Kategori --</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.id %>" <%= cat.id === product.CategoryId ? 'selected' : '' %>>
            <%= cat.name %>
          </option>
        <% }) %>
      </select>
    </div>
    <br>

    <div>
      <label>Harga (Rp):</label><br>
      <input type="number" name="price" value="<%= product.price %>" required>
    </div>
    <br>

    <div>
      <label>Stok:</label><br>
      <input type="number" name="stock" value="<%= product.stock %>" required>
    </div>
    <br>

    <div>
      <label>Link Gambar (URL):</label><br>
      <input type="text" name="imageUrl" value="<%= product.imageUrl %>">
    </div>
    <br>

    <div>
      <label>Deskripsi:</label><br>
      <textarea name="description" rows="4"><%= product.description %></textarea>
    </div>
    <br>

    <button type="submit">Update Produk</button>
    <a href="/products">Batal</a>
  </form>
</body>
</html>