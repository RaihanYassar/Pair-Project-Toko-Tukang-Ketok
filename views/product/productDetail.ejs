<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f5f5f5;
            color: #292929;
            line-height: 1.6;
        }

        h2 {
            max-width: 1000px;
            margin: 40px auto 25px;
            padding: 0 20px;
            font-size: 28px;
        }

        body > p,
        body > a {
            max-width: 1000px;
            margin-left: auto;
            margin-right: auto;
        }

        body > p {
            margin-top: 0;
            margin-bottom: 18px;
            padding: 0 20px;
            color: #555;
        }

        body > p:first-of-type {
            padding: 0;
        }

        body > p img {
            display: block;
            width: 100%;
            max-width: 420px;
            height: 280px;
            margin: 0 auto;
            object-fit: contain;
            background-color: white;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px;
        }

        body > p strong {
            color: #292929;
        }

        body > p:nth-of-type(2),
        body > p:nth-of-type(3),
        body > p:nth-of-type(4),
        body > p:nth-of-type(5) {
            max-width: 960px;
            padding: 14px 18px;
            background-color: white;
            border-bottom: 1px solid #eee;
        }

        body > p:nth-of-type(2) {
            border-top: 4px solid #ff8c32;
            border-radius: 6px 6px 0 0;
        }

        body > p:nth-of-type(5) {
            min-height: 80px;
            border-radius: 0 0 6px 6px;
        }

        body > p:nth-of-type(6) {
            margin-top: 25px;
            text-align: center;
        }

        body > p a,
        body > a {
            display: inline-block;
            padding: 10px 18px;
            border-radius: 5px;
            background-color: #ff8c32;
            color: white;
            font-size: 14px;
            font-weight: bold;
            text-decoration: none;
            transition: 0.2s;
        }

        body > p a:hover,
        body > a:hover {
            background-color: #e87518;
        }

        body > a {
            display: block;
            width: fit-content;
            margin-top: 25px;
            margin-bottom: 45px;
        }

        @media (max-width: 600px) {
            h2 {
                margin-top: 30px;
                font-size: 23px;
            }

            body > p img {
                width: 90%;
                height: 220px;
            }

            body > p:nth-of-type(2),
            body > p:nth-of-type(3),
            body > p:nth-of-type(4),
            body > p:nth-of-type(5) {
                margin-left: 15px;
                margin-right: 15px;
                padding: 12px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partial/navbar') %>
    
    <h2>Detail Barang: <%= product.name %></h2>
    <p><img src="<%= product.imageUrl %>" width="300px" height="200px"></p>
    <p><strong>Kategori:</strong> <%= product.Category ? product.Category.name : '-' %></p>
    <p><strong>Harga:</strong> <%= product.changeToRupiah %></p>
    <p><strong>Stok:</strong> <%= product.stock %></p>
    <p><strong>Deskripsi:</strong> <%= product.description %></p>

    <% if (sessionUser && sessionUser.role === 'seller') { %>
        <p>
            <a href="/products/<%= product.id %>/edit">Edit</a> ||
            <a href="/products/<%= product.id %>/delete">Delete</a>
        </p>
    <% } %>
    <a href="/products">Kembali</a>
</body>
</html>