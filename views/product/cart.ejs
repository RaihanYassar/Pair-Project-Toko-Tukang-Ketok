<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            color: #292929;
        }

        h2 {
            margin-top: 30px;
            margin-bottom: 20px;
            color: #242424;
            font-size: 28px;
        }

        p {
            margin: 10px 0;
            line-height: 1.6;
        }

        table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
            background-color: #ffffff;
            border: 1px solid #dddddd;
            border-radius: 6px;
            overflow: hidden;
        }

        th {
            padding: 14px 12px;
            background-color: #242424;
            color: #ffffff;
            text-align: left;
            font-size: 14px;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #e5e5e5;
            font-size: 14px;
        }

        tbody tr:hover {
            background-color: #fff3e8;
        }

        h3 {
            margin-top: 20px;
            color: #242424;
        }

        h3:not(:first-of-type) {
            padding: 15px;
            background-color: #ffffff;
            border-left: 4px solid #ff8c32;
            border-radius: 4px;
        }

        a {
            display: inline-block;
            margin: 5px 0;
            color: #d96813;
            font-weight: bold;
            text-decoration: none;
        }

        a:hover {
            color: #a94d08;
            text-decoration: underline;
        }

        button {
            padding: 11px 18px;
            border: none;
            border-radius: 5px;
            background-color: #ff8c32;
            color: #242424;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background-color: #e8751c;
        }

        @media (max-width: 700px) {
            body {
                padding: 18px;
            }

            h2 {
                font-size: 23px;
            }

            table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }

            th,
            td {
                padding: 10px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partial/navbar') %>

    <h2>Keranjang Belanja Anda</h2>
    <% if (orders.length > 0 && orders[0].User && orders[0].User.UserProfile) { %>
        <p><strong>Nama Pembeli:</strong> <%= orders[0].User.UserProfile.firstName %> <%= orders[0].User.UserProfile.lastName %></p>
        <p><strong>Email:</strong> <%= orders[0].User.email %></p>
    <% } %>
    <br>

    <% if (orders.length === 0) { %>
        <p>Keranjang belanjaan masih kosong, bro!</p>
        <br>
        <a href="/products">Kembali Belanja</a>
    <% } else { %>
        <% orders.forEach(order => { %>
            <table border="1" cellpadding="8" cellspacing="0">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Nama Produk</th>
                        <th>Kategori</th>
                        <th>Harga Satuan</th>
                        <th>Jumlah (Qty)</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <% let grandTotal = 0; %>
                    <% order.Products.forEach((prod, i) => { %>
                        <% let qty = prod.OrderItem.totalPrice || 1; %>
                        <% let subtotal = prod.price * qty; %>
                        <% grandTotal += subtotal; %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td><%= prod.name %></td>
                            <td><%= prod.Category ? prod.Category.name : '-' %></td>
                            <td><%= formatRupiah(prod.price) %></td>
                            <td><%= qty %></td>
                            <td><%= formatRupiah(subtotal) %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            <h3>Total Pembayaran: <%= formatRupiah(grandTotal) %></h3>
            <br>
            <a href="/orders/<%= order.id %>/invoice">
                <button>Lihat / Cetak Invoice</button>
            </a>
        <% }) %>
    <% } %>

    <br><br>
    <a href="/products">Kembali</a>
</body>
</html>