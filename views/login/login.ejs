<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 0 20px 40px;
            font-family: Arial, sans-serif;
            background: #1c1c1c;
            color: #f1f1f1;
        }

        h2 {
            margin: 0 auto 28px;
            padding-top: 65px;
            text-align: center;
            color: #f1f1f1;
            font-size: 30px;
        }

        /* Pesan error login */
        body > p {
            max-width: 490px;
            margin: 0 auto 18px;
            color: #ff4545;
            text-align: center;
        }

        /* Form login */
        form {
            width: 100%;
            max-width: 490px;
            margin: 0 auto;
            padding: 35px;
            background: #181818;
            border: 1px solid #383838;
            border-top: 5px solid #ff8c32;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
        }

        input {
            width: 100%;
            padding: 12px;
            margin: 10px 0 20px;
            box-sizing: border-box;
            background: #2b3544;
            color: white;
            border: 1px solid #414956;
            border-radius: 5px;
        }

        button {
            width: 100%;
            padding: 14px;
            margin-top: 8px;
            background: #b85100;
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
        }

        button {
            background: #e8751c;
        }

        @media (max-width: 600px) {
            body {
                padding-right: 15px;
                padding-left: 15px;
            }

            form {
                padding: 25px 20px;
            }

        }
    </style>
</head>
<body>
    <%- include('../partial/navbar') %>
    
    <h2>Halaman Login</h2>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/login" method="POST">
        <label>Email</label><br>
        <input type="email" name="email" required><br><br>

        <label>Password</label><br>
        <input type="password" name="password" required><br><br>

        <button type="submit">Masuk</button>
    </form>
</body>
</html>